# Real MongoDB URI (Atlas / local). Leave unset to auto-run an in-memory
# mongod backed by server/.data/db — zero install for local demos.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/jan-seva

PORT=4000
CORS_ORIGIN=http://localhost:5173
# ---- Civic-data sync (node-cron) ----
# Uncomment + set these to point at real endpoints later; when unset, the
# scheduler falls back to the bundled server/fixtures/*.html demo pages.
ENABLE_SYNC_SCHEDULER=true
SYNC_INTERVAL_MINUTES=30
# SCRAPE_TARGET_URL=file:///home/noor_mohammed57/jan-seva/server/fixtures/mock-gov-services.html
# SCRAPE_NOTIFICATIONS_URL=file:///home/noor_mohammed57/jan-seva/server/fixtures/mock-notifications.html
# Manual trigger POST /api/sync/run (dev only)
ENABLE_MANUAL_SYNC=true
